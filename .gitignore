# Secrets
.env

# Rust. api/.sqlx is committed, since it is what lets the crate build without a
# database
/target/
/api/target/

# Analytical tier: raw downloads and the local DuckDB file are data, not source
/analytics/data/
*.duckdb
*.duckdb.wal
*.parquet

# Browser application. node_modules and the build output are derived, and
# .env.local holds whatever the developer pointed the application at
/web/node_modules/
/web/.vite/
/web/dist/
/web/coverage/
/web/playwright-report/
/web/test-results/
/web/.env.local
/web/.env

# Editors and tooling
*.swp
.DS_Store
