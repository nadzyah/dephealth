# Copy to .env.local and adjust. Vite only exposes variables that start with
# VITE_, and everything here reaches the browser, so nothing secret belongs in
# this file.

# Where the API answers. The service allows this application's origin by name,
# which is API_CORS_ORIGINS in the repository root .env.
VITE_API_BASE_URL=http://localhost:8080

# true serves the application from the responses committed in
# src/api/fixtures, so it runs with no service and no database behind it. This
# is what the deployed demo and the end to end tests use.
VITE_DEMO=false

# debug, info, warn or error. Defaults to debug in development and info in a
# build.
VITE_LOG_LEVEL=debug
