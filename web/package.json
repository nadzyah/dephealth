{
    "name": "web",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "lint": "eslint .",
        "preview": "vite preview",
        "build:demo": "tsc -b && VITE_DEMO=true vite build",
        "test": "vitest run",
        "test:watch": "vitest",
        "coverage": "vitest run --coverage",
        "e2e": "playwright test",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc -b",
        "mockups": "node scripts/mockups.mjs",
        "fixtures": "node scripts/fixtures.mjs",
        "screenshots": "npm run build:demo && (npm run preview -- --port 4173 --host 127.0.0.1 &) && sleep 4 && node scripts/screenshots.mjs"
    },
    "dependencies": {
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router-dom": "^7.18.7",
        "zustand": "^5.1.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.65.1",
        "@testing-library/jest-dom": "^8.0.0",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.13",
        "@types/node": "^26.6.7",
        "@types/react": "^19.3.1",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "@vitest/coverage-v8": "^5.1.1",
        "eslint": "^10.15.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.8",
        "globals": "^17.14.0",
        "jsdom": "^31.0.1",
        "prettier": "^3.10.1",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.74.0",
        "vite": "^8.3.8",
        "vitest": "^5.1.1"
    }
}
