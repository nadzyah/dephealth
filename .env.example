# Copy to .env and fill in. .env is ignored by git and no password belongs in
# the repository, in a migration, or in a connection string that gets logged.

# The database and the role that owns the schema. Migrations run as this role.
# It owns only this schema and is not a superuser.
POSTGRES_DB=dephealth
POSTGRES_USER=dephealth_owner
POSTGRES_PASSWORD=
POSTGRES_PORT=55432

DATABASE_URL=postgres://dephealth_owner:@127.0.0.1:55432/dephealth?sslmode=prefer

# Passwords for the three login roles created by `make roles`. Each login role
# belongs to one group role and holds no privilege of its own.
# sslmode=prefer is for a loopback connection in development only. A deployment
# uses sslmode=verify-full, which is what db/roles/README.md describes.
INGEST_PASSWORD=
APP_PASSWORD=
PUBLIC_READ_PASSWORD=

# Salt for the manifest fingerprint. It is held by the application and never
# stored in the database, so that a reader of the report table cannot test a
# guessed dependency set against a stored fingerprint.
MANIFEST_SALT=

# The API tier. It connects as the application login role and not as the owner,
# so the privilege boundary of db/roles/README.md applies to it.
API_DATABASE_URL=postgres://dephealth_app_login:@127.0.0.1:55432/dephealth?sslmode=prefer
API_BIND=127.0.0.1:8080

# The port docker compose publishes the API on, if 8080 is taken
API_PORT=8080

# Where the browser application reaches the API from. Several are separated by
# commas, and nothing else is allowed to call it from a browser.
API_CORS_ORIGINS=http://localhost:5173

# The host the permanent links are built with, which is the address the browser
# application is served from rather than the API itself.
API_PUBLIC_BASE_URL=http://localhost:5173

# At least 32 characters. Withdrawal is the only operation it authorises, and
# leaving it empty disables withdrawal through the API.
API_ADMIN_TOKEN=

# Log verbosity, as a tracing filter, and the output form. One JSON object per
# event where a collector reads the log, which is what docker compose sets, and
# the human form otherwise.
API_LOG=info
API_LOG_FORMAT=text
